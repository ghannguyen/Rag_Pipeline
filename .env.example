# System Configuration for vi-coze RAG

EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Torch device for embedding/reranking: auto picks cuda -> cpu.
# Apple Silicon: TORCH_DEVICE=mps helps only with >= 16 GB RAM (8 GB swaps).
# TORCH_DEVICE=mps

RETRIEVAL_TOP_K=10
RERANK_TOP_N=5
RERANK_THRESHOLD=0.35

MAX_CONTEXT_TOKENS=4000

# Comma-separated file names; when two chunks are near-duplicates (same article
# in two PDFs), the chunk from these sources is kept, e.g. the consolidated law.
# PREFERRED_SOURCES=Văn-bản-hợp-nhất-18-VBHN-VPQH.pdf

# LLM Provider Options: gemini | openai | ollama | mock
LLM_PROVIDER=gemini
# LLM_MODEL applies only to LLM_PROVIDER; per-provider overrides take priority.
LLM_MODEL=gemini-3.6-flash
# GEMINI_MODEL=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200

# API Keys (Set your key here)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
